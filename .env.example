# Claude for every LLM call. Cost policy: only models under $1 per million tokens (input and output), and no
# prompt over 90K tokens (Haiku 5.5's price rises past 100K). llm.py refuses anything else; no override.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5
TYPESAFE_API_KEY=          # optional: Jev picks each browser step in ~0.5 s; without it Claude does every step
