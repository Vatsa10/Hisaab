# secrets and personal data - never commit
.env
settings.json
expenses.db
profiles/
logs/
reports/
runs/

# learned at runtime from your own accounts (contain account-specific URLs); seeds are generic and tracked
recipes/*.json
recipes/*.hint.txt
!recipes/*.seed.json

__pycache__/
.pytest_cache/
.ruff_cache/

# brainstorming mockups
.superpowers/

# per-user browser profiles (server worker)
profiles_users/

# local file:// profile vault (encrypted with the public dev key when ALLOW_DEV_PROFILE_KEY=1)
vault_local/

# Supabase CLI scratch state
supabase/.temp/

# Azure deploy secrets
deploy/azure/.env.deploy

# git worktrees used by parallel build agents
.claude/worktrees/

# local Supabase dev env (written by scripts/dev_supabase.sh)
web/.env.local
.env.server.local
.env.local
