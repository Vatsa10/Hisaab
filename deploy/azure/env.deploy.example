# Copy to deploy/azure/.env.deploy (gitignored) and fill in. Plain KEY=value lines, no quotes.
# Supabase Postgres: the SESSION pooler (port 5432) with sslmode=require
# never the transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.<ref>:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# The ask_reader login (migration 0006; set its password first, see docs/dev-supabase.md): same pooler, same rules
ASK_DATABASE_URL=postgresql://ask_reader.<ref>:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# The PWA's https origin(s), comma separated
CORS_ORIGINS=https://<your-pwa-domain>
# Claude Haiku 5.5 is the only model (ANTHROPIC_MODEL defaults to claude-haiku-5-5)
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
# Key used to encrypt stored browser profiles; deployed into Key Vault, read only by the worker
PROFILE_MASTER_KEY=
# Residential/mobile proxy URL template for the worker
PROXY_URL_TEMPLATE=
# Optional bicep parameters (budget, unit costs, limits, cart, fill and hardening tunables, SMTP, VAPID, APP_URL; the
# defaults in main.bicep equal server/config.py). deploy.sh does not read them: pass them to
# `az deployment group create` as extra name=value parameters. Set smtpPort (and smtpStarttls) together with smtpHost.
# monthlyBudgetInr=5000 proxyInrPerGb=400 aiInrPer1kTokens=0.05 workerInrPerMinute=0.20 fixedMonthlyInr=0
# refreshPerAppPerDay=3 cartChecksPerDay=10 syncIntervalH=24 pausedSyncIntervalH=72 appUrl=https://example.com
# maxJobAttempts=3 backoffBaseS=60 backoffMaxS=3600 backoffResetH=24 errorBudgetWindowH=24 errorBudgetMinJobs=10
# errorBudgetMaxFailurePct=30 needsLoginRemindH=72
# smtpHost= smtpPort=587 smtpStarttls=1 smtpUser= smtpPassword= smtpFrom= vapidPublicKey= vapidPrivateKey= vapidSubject=mailto:you@example.com
# Optional overrides
# LOCATION=centralindia
# PREFIX=expagent
