# Copy to deploy/azure/.env.deploy (gitignored) and fill in. Plain KEY=value lines, no quotes.
# Supabase Postgres connection string (use the session/direct one, port 5432)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
# Key used to encrypt stored browser profiles
PROFILE_MASTER_KEY=
# Residential/mobile proxy URL template for the worker
PROXY_URL_TEMPLATE=
# Optional bicep parameters (budget, unit costs, limits, SMTP, VAPID, APP_URL; defaults in main.bicep). deploy.sh does
# not read them: pass them to `az deployment group create` as extra name=value parameters.
# monthlyBudgetInr=5000 proxyInrPerGb=400 aiInrPer1kTokens=0.05 workerInrPerMinute=0.20 fixedMonthlyInr=0
# refreshPerAppPerDay=3 cartChecksPerDay=10 syncIntervalH=24 pausedSyncIntervalH=72 appUrl=https://example.com
# smtpHost= smtpPort=587 smtpUser= smtpPassword= smtpFrom= vapidPublicKey= vapidPrivateKey= vapidSubject=mailto:you@example.com
# Optional overrides
# LOCATION=centralindia
# PREFIX=expagent
